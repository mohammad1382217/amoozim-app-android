<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Host theme for the single Activity. The UI is 100% Jetpack Compose, so this
         only governs the window before the first Compose frame. NoActionBar +
         edge-to-edge (handled in MainActivity via enableEdgeToEdge()). -->
    <style name="Theme.AmoozimCreator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>